<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_qty_on_hand" model="ir.ui.view">
        <field name="name">purchase.order.form.qty.on.hand</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list/field[@name='product_qty']" position="before">
                <field name="qty_on_hand" string="Qty On Hand" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
