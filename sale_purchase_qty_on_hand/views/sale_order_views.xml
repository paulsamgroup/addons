<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_qty_on_hand" model="ir.ui.view">
        <field name="name">sale.order.form.qty.on.hand</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list/field[@name='product_uom_qty']" position="before">
                <field name="qty_on_hand" string="Qty On Hand" optional="show"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//field[@name='user_id']" position="replace">
                <field name="salesperson_employee_id" widget="many2one_avatar_employee" options="{'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
